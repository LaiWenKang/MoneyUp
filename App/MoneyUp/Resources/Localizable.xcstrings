    "dashboard.awaiting_data" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add accounts and a budget to calculate this locally."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加账户和预算后，将在本机计算可安心支配金额。"}}}},
