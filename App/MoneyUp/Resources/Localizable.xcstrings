    "backup.error.password_short" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use a password with at least 10 characters."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"密码必须至少包含 10 个字符。"}}}},
    "backup.error.version" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Backup version %d is not supported by this build."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此版本不支持备份格式 %d。"}}}},
