    "settings.lock.five_minutes" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"5 minutes"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"5 分钟"}}}},
    "settings.lock.immediately" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Immediately"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"立即"}}}},
    "settings.lock.one_hour" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"1 hour"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"1 小时"}}}},
