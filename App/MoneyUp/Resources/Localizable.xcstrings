    "history.filter.amount_note" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Applied independently to each transaction amount in its own currency."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"按每笔交易自身币种的金额分别筛选。"}}}},
