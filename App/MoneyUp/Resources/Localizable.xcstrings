    "settings.auto_lock_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Financial information is covered immediately in the app switcher. The timer controls when decrypted book data is cleared from memory."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"进入应用切换器时会立即遮盖财务信息。此计时器控制何时从内存清除已解密账本。"}}}},
    "settings.default_account" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Default account"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"默认账户"}}}},
