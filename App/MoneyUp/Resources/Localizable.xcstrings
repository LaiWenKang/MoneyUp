    "inventory.partial" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Some nested activity could not be decoded. Stored record counts remain exact; inspect quarantined records before relying on nested counts."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"部分嵌套活动无法解码。存储记录计数仍然准确；依赖嵌套计数前，请先检查隔离记录。"}}}},
