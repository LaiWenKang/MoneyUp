    "foundation.notice.message" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The interface is ready, but encrypted persistence is not connected yet. This draft has not been saved."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"界面已就绪，但加密存储尚未接入。本次草稿没有被保存。"}}}},
