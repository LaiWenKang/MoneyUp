      }
    },
    "dashboard.private_by_design" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Private by design" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "隐私优先设计" } }
      }
    },
    "dashboard.privacy_detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your financial data stays on this device unless you choose to export it." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "除非你主动导出，否则财务数据只保留在此设备上。" } }
      }
    },
    "dashboard.safe_to_spend" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Safe to spend" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "可安心支配" } }
      }
    },
    "foundation.notice.message" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The interface is ready, but encrypted persistence is not connected yet. This draft has not been saved." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "界面已就绪，但加密存储尚未接入。本次草稿没有被保存。" } }
      }
    },
    "foundation.notice.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Foundation build" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "基础版本" } }
      }
    },
    "placeholder.assets" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Track bank accounts, liabilities, cards, investments, and net worth without mixing transfers with spending." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "管理银行账户、负债、卡片、投资与净资产，同时避免把转账误算为支出。" } }
      }
    },
    "placeholder.calendar" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "See actual transactions, scheduled bills, income, and projected cash flow together." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "集中查看实际交易、计划账单、收入与预测现金流。" } }
      }
    },
    "placeholder.insights" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Understand budget variance, spending velocity, category changes, and net-worth trends." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "洞察预算偏差、消费速度、分类变化与净资产趋势。" } }
      }
    },
    "placeholder.plan" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Build nested budgets whose spending rolls up from subcategories to parent limits." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "创建多层预算，让子分类支出自动汇总到上级限额。" } }
