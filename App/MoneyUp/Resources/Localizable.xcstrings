    "error.currency_precision" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ supports up to %d decimal places."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ 最多支持 %d 位小数。"}}}},
    "error.cross_currency_edit" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Changing an existing transaction to an account with another currency is not supported. Keep an account with the original currency, or record the conversion as a transfer."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"不支持将现有交易改到其他币种的账户。请保留原币种账户，或将换汇另行记录为转账。"}}}},
    "history.edit" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Edit transaction"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"编辑交易"}}}},
    "history.edit_not_supported" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Balance adjustments and investment entries are read-only here. You can still delete this entry."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"余额调整和投资分录在此处仅供查看，但仍可删除。"}}}},
