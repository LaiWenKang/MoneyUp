    "goal.error.invalid" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Check the name, positive target, date, currency, and reset rule."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请检查名称、正数目标、日期、币种与重置规则。"}}}},
