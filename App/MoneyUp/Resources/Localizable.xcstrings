    "assets.account_net_worth_note" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Ledger assets minus liabilities, kept separate by currency. Linked positions are already included exactly once."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"账本资产减去负债，并按币种分开显示。已连接持仓只计入一次。"}}}},
