    "history.total_explanation" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Signed movement is shown separately for each currency. Same-currency transfers may offset to zero; no exchange rate is assumed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正负变动按币种分别显示。同币种转账可能抵销为零；不假设任何汇率。"}}}},
    "history.no_filtered_total" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No monetary movement in these results"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"筛选结果中没有金额变动"}}}},
