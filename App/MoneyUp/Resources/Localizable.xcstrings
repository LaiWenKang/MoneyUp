    "quick_log.smart_footer" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Text is read on this device by iOS. The image is never uploaded and stays transient unless you explicitly keep it with the saved transaction; every field remains editable."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"文字由 iOS 在本机识别。图片绝不会上传，除非你明确选择随已保存交易保留，否则只会短暂存在；所有字段仍可修改。"}}}},
    "quick_log.smart_nothing_found" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Nothing recognizable. Fill the fields below instead."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未能识别内容，请在下方手动填写。"}}}},
    "quick_log.smart_placeholder" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"lunch 12.50 cash yesterday"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"昨天 现金 午餐 12.50"}}}},
    "recovery.erase" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Erase inaccessible data"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"抹掉无法访问的数据"}}}},
    "recovery.erase_confirm" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Erase everything"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"抹掉全部数据"}}}},
    "recovery.erase_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This permanently deletes the encrypted database and protected key from this device. It cannot be undone."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这会永久删除此设备上的加密数据库和受保护密钥，且无法撤销。"}}}},
