    "history.search" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Search payee, category, account or amount"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"搜索商家、分类、账户或金额"}}}},
    "import.atomic_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Accepted rows are committed together. If saving fails, the current book is unchanged."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可接受的记录会一次性提交；若保存失败，当前账本不会改变。"}}}},
    "import.choose_csv" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose CSV or TSV file"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择 CSV 或 TSV 文件"}}}},
    "import.commit" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Import reviewed transactions"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导入已检查的交易"}}}},
    "import.complete_format" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Imported %d; skipped %d duplicates and %d rows needing review."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已导入 %d 条；跳过 %d 条重复记录及 %d 条需检查记录。"}}}},
    "import.error.columns" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The file needs a date column and an amount, outflow, or inflow column."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"文件需包含日期列，以及金额、支出金额或收入金额列。"}}}},
    "import.error.empty" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The selected file is empty."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所选文件为空。"}}}},
    "import.error.encoding" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use a UTF-8 or UTF-16 CSV file."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请使用 UTF-8 或 UTF-16 编码的 CSV 文件。"}}}},
    "import.error.malformed" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The CSV contains an unfinished quoted field."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"CSV 中有未结束的引号字段。"}}}},
    "import.error.moneyup_export" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This is MoneyUp's balanced posting export. Use a .moneyup archive for full-fidelity restore; importing each posting as a transaction would duplicate the ledger."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这是 MoneyUp 的平衡分录导出。请使用 .moneyup 备份进行完整恢复；若将每条分录当作交易导入会造成重复。"}}}},
    "import.error.too_large" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Import up to 20,000 rows in a file smaller than 10 MB."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"单次最多导入 20,000 条，文件需小于 10 MB。"}}}},
    "import.fallbacks" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Fallback mapping"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"备用映射"}}}},
    "import.fallbacks_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MoneyUp matches account and category names first. These choices are used only when a row omits a name or no same-currency account matches. New named categories are created automatically."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MoneyUp 会先匹配账户和分类名称。仅当记录缺少名称或找不到同币种账户时才使用这些选项；新的分类名称会自动创建。"}}}},
