    "placeholder.assets" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Track bank accounts, liabilities, cards, investments, and net worth without mixing transfers with spending."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"管理银行账户、负债、卡片、投资与净资产，同时避免把转账误算为支出。"}}}},
