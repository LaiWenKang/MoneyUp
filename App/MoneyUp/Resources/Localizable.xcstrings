    "transaction.to_account" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"To"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"转入账户"}}}},
    "transaction.transfer" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Transfer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"转账"}}}},
    "whats_new.0_2_0.appearance" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A royal-blue look with restrained gold highlights and a new app icon; budgets now show what is left and whether you are ahead of the month."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"全新宝蓝主色与克制的金色点缀，并配有新应用图标；预算现在显示剩余金额，以及是否领先于时间进度。"}}}},
    "whats_new.0_2_0.currencies" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reports keep every currency. Money spent outside your base currency is listed separately instead of being left out."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"报表保留所有币种。非本位币的收支会单独列出，不再被忽略。"}}}},
    "whats_new.0_2_0.periods" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose the report period: this month, last month, 3, 6 or 12 months, or year to date."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可选择统计区间：本月、上月、近 3/6/12 个月或今年至今。"}}}},
    "whats_new.0_2_0.smart_entry" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Log from a receipt photo or a typed phrase. Everything is read on this device."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可通过收据照片或一句话记账，全部在本机识别。"}}}},
    "whats_new.subtitle %@" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Version %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"版本 %@"}}}},
    "whats_new.title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"What's new"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"更新内容"}}}},
    "holding.archived" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Archived holdings"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已归档持仓"}}}},
    "holding.archived_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This holding is archived. Its price, lot, disposal, and journal history remains available for review."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此持仓已归档；价格、批次、处置及账本历史仍可查看。"}}}},
    "holding.delete_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Only a holding with zero remaining quantity can be archived. Its price, lot, disposal, and ledger history will remain available."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"只有剩余数量为零的持仓可以归档；价格、批次、处置及账本历史仍会保留。"}}}},
    "holding.delete_title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Archive this holding?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"归档此持仓？"}}}},
    "privacy.export_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Only an export you start can send data outside MoneyUp. CSV and XLSX files are readable after export; receipt image bytes remain excluded."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"只有你主动发起导出时，数据才会离开 MoneyUp。CSV 与 XLSX 文件导出后可直接读取；收据图片不会包含在内。"}}}},
    "privacy.export_title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"You control exports"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导出由你掌控"}}}},
    "privacy.local_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MoneyUp has no user account or finance backend. Transactions, budgets, and receipt text are processed on this iPhone."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MoneyUp 无需注册，也没有财务数据后端。交易、预算和收据文字均在此 iPhone 上处理。"}}}},
    "privacy.local_title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local by default"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"默认仅存本机"}}}},
    "privacy.no_tracking_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"There are no ads, analytics SDKs, remote AI calls, or financial-data network requests."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"不含广告、分析 SDK、远程 AI 调用或财务数据网络请求。"}}}},
    "privacy.no_tracking_title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No tracking"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"不追踪"}}}},
    "privacy.protected_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The database is encrypted with a random, device-bound key protected by your passcode or biometrics. Removing the passcode can destroy that key; decrypted data is cleared after auto-lock."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"数据库使用随机的设备绑定密钥加密，并由设备密码或生物识别保护。移除设备密码可能销毁该密钥；自动锁定后会从内存清除已解密数据。"}}}},
    "privacy.protected_title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Protected on device"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本机加密保护"}}}},
    "privacy.read_policy" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Read the full privacy policy"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"阅读完整隐私政策"}}}},
    "privacy.recovery_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keep a password-protected .moneyup backup outside the app before removing the device passcode, deleting MoneyUp, or changing devices. CSV is not a full recovery backup."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在移除设备密码、删除 MoneyUp 或更换设备前，请在应用之外保留受密码保护的 .moneyup 备份。CSV 不是完整恢复备份。"}}}},
    "privacy.recovery_title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Portable recovery"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"便携恢复"}}}},
    "privacy.summary" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"How your data is handled"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"数据处理方式"}}}},
    "privacy.title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Privacy and beta"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"隐私与测试"}}}},
    "privacy.your_choices" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your choices"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的选择"}}}},
    "schedule.delete_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This stops all future projections from this schedule. Transactions already recorded are unchanged."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这会停止此计划的所有未来预测，已记录的交易不会更改。"}}}},
    "schedule.delete_title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete this schedule?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除此计划？"}}}},
    "testing.feedback_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use Send Beta Feedback in TestFlight. Describe the steps and version, but hide real balances, receipts, and names in screenshots."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请使用 TestFlight 中的“发送 Beta 版反馈”。说明操作步骤和版本，但请在截图中遮盖真实余额、收据和姓名。"}}}},
    "testing.feedback_title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Private feedback"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保护隐私的反馈"}}}},
    "testing.first_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Start with small sample amounts. Test quick logging, corrections, budgets, the calendar, background locking, the widget, and CSV export before entering a full month."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先使用小额样例，测试快速记账、更正、预算、日历、后台锁定、小组件和 CSV 导出，再录入完整月份。"}}}},
    "testing.first_title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Founders test"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"首轮测试"}}}},
    "testing.read_support" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open support guidance"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开支持说明"}}}},
    "testing.title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"TestFlight beta"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"TestFlight 测试版"}}}},
    "transaction.delete_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This permanently removes the transaction and reverses its effect on balances, budgets, and reports."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这会永久移除该交易，并撤销其对余额、预算和报表的影响。"}}}},
    "transaction.delete_title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete this transaction?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除此交易？"}}}},
    "whats_new.0_3_0.beta" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A founders-test guide now explains the safest way to try each core workflow and send private TestFlight feedback."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"新增首轮测试指南，说明如何安全体验核心流程并通过 TestFlight 反馈。"}}}},
    "whats_new.0_3_0.deletion" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Transactions, schedules, and holdings now require confirmation before permanent deletion."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"永久删除交易、计划收支和持仓前，现在都会要求确认。"}}}},
    "whats_new.0_3_0.privacy" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Privacy and beta information is available in the app, with clearer export and recovery limits."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"应用内现已提供隐私与测试说明，并更清楚地说明导出和恢复限制。"}}}},
    "export.data" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Export ledger"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导出账本"}}}},
    "export.xlsx" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Excel workbook (.xlsx)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Excel 工作簿（.xlsx）"}}}},
    "fx.add_rate" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add historical rate"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加历史汇率"}}}},
    "fx.base_currency" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Base currency"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"基准币种"}}}},
    "fx.currency_code_hint" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter a 3-to-8-character currency or asset code."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入 3 至 8 个字符的货币或资产代码。"}}}},
    "fx.delete_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This historical rate will be permanently deleted. Existing transactions remain unchanged; future estimates may become unconverted."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此历史汇率将被永久删除。现有交易不会改变；之后的估算可能会变为未换算。"}}}},
    "fx.delete_title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete historical rate?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除历史汇率？"}}}},
    "fx.effective_date" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Effective date"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"生效日期"}}}},
    "fx.effective_day_format" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Effective day %lld · %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"生效日 %lld · %@"}}}},
    "fx.error.identical" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose two different currencies."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请选择两个不同的币种。"}}}},
    "fx.error.conversion_out_of_range" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This conversion is outside MoneyUp's safe amount range. Use a smaller amount or review the rate."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此换算超出 MoneyUp 的安全金额范围。请使用较小金额或检查汇率。"}}}},
    "fx.error.conversion_underflow" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This non-zero conversion is smaller than the destination currency can represent."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此非零换算结果小于目标币种可表示的最小金额。"}}}},
    "fx.error.invalid_date" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This effective date is invalid or does not match its reporting time zone."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此生效日期无效，或与其报告时区不一致。"}}}},
    "fx.error.invalid_rate" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter an exchange rate greater than zero."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入大于零的汇率。"}}}},
    "fx.estimate_accessibility_hint" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Fills the received amount using your latest applicable historical rate; review it before saving."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用最近适用的历史汇率填入到账金额；保存前请检查。"}}}},
    "fx.estimated_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Conversions are visibly marked as estimates. MoneyUp never downloads or assumes a market rate."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"换算结果会明确标注为估算值。MoneyUp 不会下载或臆测市场汇率。"}}}},
    "fx.net_worth_estimated" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Includes user-rate estimates"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"包含用户汇率估算"}}}},
    "fx.net_worth_complete_rate_needed" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Currencies stay separate until every non-zero foreign balance has an applicable dated rate."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在每个非零外币余额都有适用的日期汇率之前，各币种会保持分开。"}}}},
    "fx.rates_as_of" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"rates as of"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"汇率日期"}}}},
    "fx.snapshot_conversion_evidence" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Frozen conversion evidence"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已冻结的换算依据"}}}},
    "fx.snapshot_evidence_format" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ × %@ ≈ %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ × %@ ≈ %@"}}}},
    "fx.snapshot_rate_day_format" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Rate day %lld · %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"汇率日 %lld · %@"}}}},
    "fx.snapshot_direct" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"direct"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"直接汇率"}}}},
    "fx.snapshot_inverse" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"inverse"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"反向汇率"}}}},
    "fx.net_worth_unconverted_format" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unconverted foreign balances: %lld"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仍有 %lld 个外币余额未换算"}}}},
    "fx.no_rates" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No saved rates"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有已保存汇率"}}}},
    "fx.quote_currency" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Quote currency"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"计价币种"}}}},
    "fx.quote_per_base" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Quote units per 1 base unit"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每 1 基准币的计价币数量"}}}},
    "fx.rate_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter the dated rate you actually used or trust. A later rate never changes an earlier transaction."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入你实际使用或信任的日期汇率。之后添加的汇率不会改变较早的交易。"}}}},
    "fx.save_rate" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Save rate"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保存汇率"}}}},
    "fx.saved_rates" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Saved rates"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已保存汇率"}}}},
    "fx.title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Exchange rates"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"汇率"}}}},
    "fx.unconverted_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Without an applicable rate, foreign amounts remain separate and unconverted."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有适用汇率时，外币金额会保持独立且不换算。"}}}},
    "fx.unconverted_mode" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No applicable rate · keep unconverted"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有适用汇率 · 保持不换算"}}}},
    "fx.use_estimate_format" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use estimated %@ %@ · rate day %lld"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用估算 %@ %@ · 汇率日 %lld"}}}},
    "import.apply_mapping" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Apply column mapping"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"应用栏位映射"}}}},
    "import.column_mapping" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Column mapping"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"栏位映射"}}}},
    "import.column_mapping_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review every detected column. Date and one amount, outflow, or inflow column are required."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请检查每个栏位。日期，以及金额、支出或收入栏位中的至少一个为必填。"}}}},
    "import.column_none" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Not present"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"不存在"}}}},
