    "backup.detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use a unique password of at least 10 characters. MoneyUp cannot recover this password."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请使用至少 10 个字符的独立密码。MoneyUp 无法找回此密码。"}}}},
