    "lock.authentication_reason" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unlock your private MoneyUp data"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"解锁你的 MoneyUp 私密数据"}}}},
