    "derived.reason.amount" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The calculated amount was invalid. Your saved records were not changed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"计算出的金额无效。已保存的记录未被更改。"}}}},
    "derived.reason.app_not_ready" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unlock MoneyUp and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请解锁 MoneyUp 后重试。"}}}},
    "derived.reason.budget" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MoneyUp could not calculate the budget. Your saved records were not changed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MoneyUp 无法计算预算。已保存的记录未被更改。"}}}},
    "derived.reason.currency" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This item has no valid currency, so its amount cannot be calculated."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此项目没有有效币种，因此无法计算金额。"}}}},
    "derived.reason.goal" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MoneyUp could not calculate this goal. Your saved records were not changed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MoneyUp 无法计算此目标。已保存的记录未被更改。"}}}},
    "derived.reason.intelligence_projection" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The month-end projection is unavailable until at least seven reporting days and all required components are valid. No zero estimate was substituted."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"至少经过七个报表日且所有必要数据有效后，才可生成月末预测；不会用零值代替缺失估算。"}}}},
    "derived.reason.intelligence_budget" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MoneyUp could not prepare budget suggestions. Your saved limits were not changed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MoneyUp 无法生成预算建议。已保存的限额未被更改。"}}}},
    "derived.reason.holding" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"One or more holding values could not be calculated. Your saved records were not changed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"一个或多个持仓价值无法计算。已保存的记录未被更改。"}}}},
    "derived.reason.invalid_period" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MoneyUp could not determine this reporting period."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MoneyUp 无法确定此报表期间。"}}}},
    "derived.reason.ledger" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MoneyUp could not calculate this value. Your saved records were not changed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MoneyUp 无法计算此数值。已保存的记录未被更改。"}}}},
    "derived.show_diagnostic" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Show diagnostic code"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"显示诊断代码"}}}},
    "derived.unavailable_title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Calculation unavailable"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法计算"}}}},
    "error.could_not_save" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Could not complete the change"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法完成更改"}}}},
    "error.field_format" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Error: %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"错误：%@"}}}},
    "error.operation_failed_title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Couldn’t complete that action"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法完成该操作"}}}},
    "error.currency_precision" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ supports up to %d decimal places."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ 最多支持 %d 位小数。"}}}},
    "error.currency_invalid" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter a valid currency code."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入有效的币种代码。"}}}},
    "error.cross_currency_edit" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Changing an existing transaction to an account with another currency is not supported. Keep an account with the original currency, or record the conversion as a transfer."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"不支持将现有交易改到其他币种的账户。请保留原币种账户，或将换汇另行记录为转账。"}}}},
    "history.edit" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Edit transaction"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"编辑交易"}}}},
    "history.edit_not_supported" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Balance adjustments and investment entries are read-only here. Use the dedicated correction workflow instead."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"余额调整和投资分录在此处仅供查看，请改用专用更正流程。"}}}},
    "history.empty" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No transaction history"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"暂无交易记录"}}}},
    "history.empty_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Transactions you log or import will appear here."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你记录或导入的交易会显示在这里。"}}}},
