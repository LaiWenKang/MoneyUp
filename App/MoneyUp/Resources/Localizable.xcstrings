    "schedule.error.entry_already_matched" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"That transaction is already linked to a schedule."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"该交易已关联到另一项计划。"}}}},
    "schedule.error.entry_mismatch" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The selected transaction does not match this schedule's amount, account, and category."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所选交易的金额、账户或分类与此计划不符。"}}}},
    "schedule.error.already_resolved" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This scheduled occurrence was already handled."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本期计划已处理。"}}}},
    "schedule.error.cannot_advance" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MoneyUp could not calculate the next date. Check the date and repeat frequency."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MoneyUp 无法计算下次日期。请检查日期和重复频率。"}}}},
    "schedule.error.invalid_resolution" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This scheduled occurrence has an invalid journal link and cannot be changed safely."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此计划发生项的账本链接无效，无法安全更改。"}}}},
    "schedule.error.linked_entry_not_found" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The scheduled occurrence no longer has the expected journal entry."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此计划发生项找不到预期的账本分录。"}}}},
    "schedule.error.invalid_lifecycle" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This scheduled transaction has inconsistent occurrence history and was not changed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此计划交易的发生历史不一致，因此未作更改。"}}}},
    "schedule.error.empty_name" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter a schedule name."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入计划名称。"}}}},
    "schedule.error.ended" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This schedule has ended and cannot be changed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此计划已结束，无法再更改。"}}}},
    "schedule.error.inactive" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This schedule is paused. Resume it before handling an occurrence."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此计划已暂停。请先恢复计划，再处理本期。"}}}},
    "schedule.error.linked_entry_required" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose a transaction to match with this scheduled occurrence."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请选择一笔交易来关联本期计划。"}}}},
    "schedule.error.positive_amount" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Schedule amount must be greater than zero."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"计划金额必须大于零。"}}}},
    "schedule.error.stale_occurrence" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This scheduled occurrence is no longer current. Refresh and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本期计划已更新。请刷新后重试。"}}}},
    "schedule.error.unexpected_linked_entry" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Only a matched occurrence can include a linked transaction."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"只有关联处理的期次才能包含对应交易。"}}}},
    "schedule.error.unsupported_kind" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Schedules support income and expenses only."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"计划仅支持收入和支出。"}}}},
