    "action.working" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Working securely…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在安全处理…"}}}},
    "backup.create" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Create encrypted backup"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"创建加密备份"}}}},
    "backup.data_safety" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Backup and recovery"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"备份与恢复"}}}},
    "backup.detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use a unique password of at least 10 characters and keep the .moneyup file outside this app. MoneyUp cannot recover this password."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请使用至少 10 个字符的独立密码，并将 .moneyup 文件保存在本应用之外。MoneyUp 无法找回此密码。"}}}},
    "backup.first_reminder" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Create your first password-protected .moneyup backup now. Removing the device passcode or deleting MoneyUp can make the live local book unrecoverable."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请立即创建第一份受密码保护的 .moneyup 备份。移除设备密码或删除 MoneyUp 可能导致本机实时账本无法恢复。"}}}},
    "backup.error.authentication" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The password is wrong or the archive has been modified."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"密码错误，或备份文件已被修改。"}}}},
    "backup.error.invalid" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This is not a valid MoneyUp backup."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这不是有效的 MoneyUp 备份。"}}}},
    "backup.error.password_short" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use a password with at least 10 characters."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"密码必须至少包含 10 个字符。"}}}},
    "backup.error.password_long" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use a backup password no longer than 1,024 bytes."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"备份密码不得超过 1,024 字节。"}}}},
    "backup.error.pending_captures" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review, save, or discard every pending locked Quick Log before creating or restoring a backup."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"创建或恢复备份前，请先查看并保存或丢弃所有待处理的锁定快捷记账。"}}}},
    "backup.error.too_large" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This book is too large for the current backup format. Remove large receipt attachments and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此账本超出当前备份格式的大小限制。请移除较大的收据附件后重试。"}}}},
    "backup.error.version" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Backup version %d is not supported by this build."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此版本不支持备份格式 %d。"}}}},
    "backup.password" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Backup password"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"备份密码"}}}},
    "backup.password_confirm" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirm password"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认密码"}}}},
    "backup.pending_captures_blocked" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Backup and restore are paused until every pending locked Quick Log is reviewed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先处理所有待查看的锁定快捷记账，然后再创建或恢复备份。"}}}},
    "backup.ready" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Encrypted backup is ready to save."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"加密备份已准备好保存。"}}}},
