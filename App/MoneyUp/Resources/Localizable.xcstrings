    "whats_new.0_2_0.appearance" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A royal-blue look with restrained gold highlights and a new app icon; budgets now show what is left and whether you are ahead of the month."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"全新宝蓝主色与克制的金色点缀，并配有新应用图标；预算现在显示剩余金额，以及是否领先于时间进度。"}}}},
    "whats_new.0_2_0.currencies" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reports keep every currency. Money spent outside your base currency is listed separately instead of being left out."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"报表保留所有币种。非本位币的收支会单独列出，不再被忽略。"}}}},
