    "foundation.notice.title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Foundation build"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"基础版本"}}}},
    "placeholder.assets" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Track bank accounts, liabilities, cards, investments, and net worth without mixing transfers with spending."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"管理银行账户、负债、卡片、投资与净资产，同时避免把转账误算为支出。"}}}},
    "placeholder.calendar" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"See actual transactions, scheduled bills, income, and projected cash flow together."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"集中查看实际交易、计划账单、收入与预测现金流。"}}}},
    "placeholder.insights" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Understand budget variance, spending velocity, category changes, and net-worth trends."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"洞察预算偏差、消费速度、分类变化与净资产趋势。"}}}},
    "placeholder.plan" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Build nested budgets whose spending rolls up from subcategories to parent limits."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"创建多层预算，让子分类支出自动汇总到上级限额。"}}}},
