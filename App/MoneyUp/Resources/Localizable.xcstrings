    "goal.reset.never" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keep until I reset"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保留至手动重置"}}}},
    "goal.reset.yearly" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Start fresh each year"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每年重新开始"}}}},
    "goal.reset_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Progress returns to zero now. The dated contribution and withdrawal history remains encrypted for audit."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"进度会立即归零；带日期的存入与取出历史仍会加密保留，以便核对。"}}}},
    "goal.reset_now" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reset progress now"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"立即重置进度"}}}},
    "goal.reset_rule" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reset behavior"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重置方式"}}}},
    "goal.reset_rule_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Monthly and yearly rules reset displayed progress at a Gregorian reporting boundary; history is retained."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"按月或按年会在公历报表边界重置显示进度，历史记录仍会保留。"}}}},
    "goal.reset_title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reset this goal's progress?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重置此目标进度？"}}}},
