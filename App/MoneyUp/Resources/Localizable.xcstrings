    "inventory.detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use before and after an update or restore. This metadata-only file contains no names, IDs, amounts, currencies, notes, balances, or receipt images."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"用于更新或恢复前后核对。此文件仅含核对元数据，不含名称、ID、金额、币种、备注、余额或收据图片。"}}}},
