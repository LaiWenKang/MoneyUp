    "settings.lock.legacy_minutes_format" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ minutes (legacy)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ 分钟（旧版设置）"}}}},
    "settings.locked_capture" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow Quick Capture while locked"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"锁定时允许快速记录"}}}},
    "settings.pending_captures" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pending secure captures"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"待处理安全速记"}}}},
