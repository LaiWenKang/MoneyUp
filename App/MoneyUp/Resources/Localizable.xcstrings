    "receipt.attachment_encrypted_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Stored only in MoneyUp's encrypted database and encrypted portable backups."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅存储在 MoneyUp 的加密数据库与加密便携备份中。"}}}},
    "receipt.attachment_image" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Saved receipt image"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已保存的收据图片"}}}},
