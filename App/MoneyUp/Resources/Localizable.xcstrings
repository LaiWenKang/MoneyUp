    "plan.foreign_not_counted" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Foreign-currency spending not counted"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未计入的外币支出"}}}},
    "plan.foreign_not_counted_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No exchange rates are stored, so foreign-currency spending stays visible but is not mixed into the base-currency budget."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MoneyUp 不存储汇率，因此外币支出会保持可见，但不会混入本位币预算。"}}}},
