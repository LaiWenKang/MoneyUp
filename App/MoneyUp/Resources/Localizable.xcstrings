    "history.filter.date" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Date range"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"日期范围"}}}},
    "history.filter.end_date" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"End date"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"结束日期"}}}},
    "history.filter.invalid_date_range" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Start date must not follow end date."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"开始日期不得晚于结束日期。"}}}},
    "history.filter.invalid_range" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Amounts cannot be negative, and minimum must not exceed maximum."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"金额不能为负数，且最小值不得大于最大值。"}}}},
    "history.filter.kind" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Transaction type"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"交易类型"}}}},
    "history.filter.maximum" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Maximum"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最大金额"}}}},
    "history.filter.minimum" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Minimum"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最小金额"}}}},
    "history.filter.start_date" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Start date"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"开始日期"}}}},
    "history.filtered_total" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Filtered total"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"筛选合计"}}}},
    "history.filters_active" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Filters active"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已启用筛选"}}}},
    "history.loading" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Loading transactions"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在载入交易"}}}},
    "history.loading_summary" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Calculating the complete result total…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在计算完整结果合计…"}}}},
    "history.summary_unavailable" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Result total unavailable"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"结果合计暂不可用"}}}},
    "history.page_unavailable" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"More transactions couldn’t be loaded"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法加载更多交易"}}}},
    "history.total_explanation" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Signed movement is shown separately for each currency. Same-currency transfers may offset to zero; no exchange rate is assumed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正负变动按币种分别显示。同币种转账可能抵销为零；不假设任何汇率。"}}}},
    "history.no_filtered_total" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No monetary movement in these results"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"筛选结果中没有金额变动"}}}},
    "history.transactions" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Transactions"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"交易笔数"}}}},
    "history.last_edited" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Last edited"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"上次编辑"}}}},
    "history.no_results" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No matching transactions"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有匹配的交易"}}}},
    "history.no_results_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Try another keyword or filter."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请尝试其他关键词或筛选条件。"}}}},
    "history.search" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Search payee, category, account or amount"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"搜索商家、分类、账户或金额"}}}},
    "import.atomic_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Accepted rows are committed together. If saving fails, the current book is unchanged."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可接受的记录会一次性提交；若保存失败，当前账本不会改变。"}}}},
    "import.choose_csv" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose CSV or TSV file"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择 CSV 或 TSV 文件"}}}},
    "import.commit" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Import reviewed transactions"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导入已检查的交易"}}}},
    "import.complete_format" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Imported %d; skipped %d duplicates and %d rows needing review."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已导入 %d 条；跳过 %d 条重复记录及 %d 条需检查记录。"}}}},
    "import.error.columns" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The file needs a date column and an amount, outflow, or inflow column."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"文件需包含日期列，以及金额、支出金额或收入金额列。"}}}},
    "import.error.empty" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The selected file is empty."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所选文件为空。"}}}},
    "import.error.encoding" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use a UTF-8 or UTF-16 CSV file."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请使用 UTF-8 或 UTF-16 编码的 CSV 文件。"}}}},
    "import.error.malformed" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The CSV contains malformed or unfinished quoted fields."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"CSV 中有格式错误或未结束的引号字段。"}}}},
    "import.error.too_many_rows" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This file has more than 20,000 transaction rows. Split it into smaller files and preview each one."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此文件超过 20,000 条交易。请拆分为较小文件并逐个预览。"}}}},
    "import.error.moneyup_export" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This is MoneyUp's balanced posting export. Use a .moneyup archive for full-fidelity restore; importing each posting as a transaction would duplicate the ledger."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这是 MoneyUp 的平衡分录导出。请使用 .moneyup 备份进行完整恢复；若将每条分录当作交易导入会造成重复。"}}}},
    "import.error.too_large" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Import up to 20,000 rows in a file smaller than 10 MB."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"单次最多导入 20,000 条，文件需小于 10 MB。"}}}},
    "import.fallbacks" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Fallback mapping"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"备用映射"}}}},
    "import.fallbacks_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MoneyUp matches account and category names first. These choices are used only when a row omits a name or no same-currency account matches. New named categories are created automatically."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MoneyUp 会先匹配账户和分类名称。仅当记录缺少名称或找不到同币种账户时才使用这些选项；新的分类名称会自动创建。"}}}},
    "import.file" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"File"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"文件"}}}},
    "import.first_rows" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"First 10 accepted rows"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"前 10 条可接受记录"}}}},
    "import.issue.invalid_amount" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Invalid amount"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"金额无效"}}}},
    "import.issue.invalid_destination_amount" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Invalid destination amount"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"目标金额无效"}}}},
    "import.issue.invalid_date" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Invalid date"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"日期无效"}}}},
    "import.issue.invalid_row" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Invalid row"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"记录无效"}}}},
    "import.issue.unsupported_type" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unsupported transaction type"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"不支持的交易类型"}}}},
    "import.line" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Line"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"第"}}}},
    "import.issue_line_format" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Line %1$d: %2$@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"第 %1$d 行：%2$@"}}}},
    "import.local_only_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Export CSV from Qianji (Settings · About → Data Export) or another budget app. Parsing and matching stay on this iPhone."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可从钱迹（设置·关于 → 数据导出）或其他记账应用导出 CSV。解析与匹配仅在此 iPhone 上完成。"}}}},
    "import.needs_review" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Rows needing review"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"需检查记录"}}}},
    "import.preview" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Import preview"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导入预览"}}}},
    "import.preview_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unsupported or malformed rows are never guessed into your ledger."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"不支持或格式错误的记录不会被猜测写入账本。"}}}},
    "import.qianji_and_csv" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Qianji and generic CSV"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"钱迹与通用 CSV"}}}},
    "import.ready" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Rows ready"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可导入记录"}}}},
    "import.review_issues" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review skipped rows"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"检查跳过的记录"}}}},
    "import.title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Import transactions"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导入交易"}}}},
    "plan.foreign_not_counted" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Foreign-currency spending not counted"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未计入的外币支出"}}}},
    "plan.foreign_not_counted_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Foreign-currency spending stays separate from the base-currency budget. User-supplied rates are shown only as estimates; missing pairs remain unconverted."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"外币支出会与本位币预算分开。用户提供的汇率只会标为估算值；缺少适用汇率时保持不换算。"}}}},
    "tab.history" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"History"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"明细"}}}},
    "transaction.currency" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Currency"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"币种"}}}},
    "transaction.date" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Date and time"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"日期与时间"}}}},
    "transaction.note" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Note"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"备注"}}}},
    "transaction.refund" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Refund"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"退款"}}}},
    "whats_new.0_4_1.history" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A new History tab adds fast search, filters, refunds, and safe transaction editing."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"全新明细标签页支持快速搜索、筛选、退款与安全编辑交易。"}}}},
    "whats_new.0_4_1.import" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Preview and import Qianji or generic CSV exports locally, with duplicate detection and atomic saving."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可在本机预览并导入钱迹或通用 CSV，自动查重并以事务方式保存。"}}}},
    "whats_new.0_4_1.safety" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Password-protected portable backup and transactional restore help your TestFlight data move safely to future releases."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"密码保护的便携备份与事务恢复，让 TestFlight 数据可安全迁移到后续正式版本。"}}}},
    "whats_new.0_4_1.speed" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Log remains leftmost, tab navigation is no longer blocked, smart defaults are configurable, and auto-lock defaults to one minute."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"记账仍在最左侧，标签切换不再受阻，可配置智能默认值，自动锁定默认为 1 分钟。"}}}},
    "capture.detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter only an amount and save—no MoneyUp unlock or balance access is needed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"只需输入金额并保存；无需解锁 MoneyUp，也不会读取余额。"}}}},
    "capture.currency_unassigned" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Currency isn’t assigned while locked. Review the amount and choose an account after unlocking."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"锁定时不会指定币种。解锁后请检查金额并选择账户。"}}}},
    "capture.error.full" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The secure capture inbox is full. Unlock MoneyUp to process pending entries."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"安全速记收件箱已满。请解锁 MoneyUp 处理待办记录。"}}}},
    "capture.error.invalid" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The secure capture inbox could not be read. Your main ledger is unaffected."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法读取安全速记收件箱。主账本不受影响。"}}}},
    "capture.input_too_long" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This optional detail is too long. Shorten it before saving."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此可选详情过长，请缩短后再保存。"}}}},
    "capture.error.unavailable" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Quick Capture is unavailable until the iPhone has been unlocked once after restarting."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"iPhone 重启后需先解锁一次，才能使用快速记录。"}}}},
    "capture.unavailable.confirm_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"These locked captures cannot be decrypted. Discarding only this unavailable inbox restores backup and restore access, but the lost captures cannot be recovered."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这些锁定记录已无法解密。仅丢弃这个不可用的收件箱可恢复备份与恢复功能，但其中记录无法找回。"}}}},
    "capture.unavailable.confirm_title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Discard unavailable captures?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"丢弃不可用的锁定记录？"}}}},
    "capture.unavailable.detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The separate locked-capture inbox cannot be decrypted. Your main ledger is still readable, but backup and restore remain paused until you explicitly discard this unavailable inbox."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"独立的锁定记录收件箱已无法解密。主账本仍可读取，但在你明确丢弃此不可用收件箱前，备份与恢复将保持暂停。"}}}},
    "capture.unavailable.discard" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Discard unavailable captures"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"丢弃不可用的锁定记录"}}}},
    "capture.unavailable.discarded" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The unavailable locked-capture inbox was discarded. Your main ledger was not changed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已丢弃不可用的锁定记录收件箱。主账本未被更改。"}}}},
    "capture.unavailable.title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Locked captures unavailable"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"锁定记录不可用"}}}},
    "capture.private" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Balances stay locked"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"余额仍保持锁定"}}}},
    "capture.reconcile_later" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Account and category are reviewed after your next intentional unlock."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下次主动解锁后再检查账户与分类。"}}}},
    "capture.title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Quick Capture"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"快速记录"}}}},
    "capture.unlock_instead" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unlock full MoneyUp instead"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"改为解锁完整 MoneyUp"}}}},
    "capture.add_details" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add optional details"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加可选详情"}}}},
    "capture.save" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Capture privately"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"私密记录"}}}},
    "capture.saved_title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Captured privately"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已私密记录"}}}},
    "capture.saved_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No balance was opened. Review the account and category after your next unlock."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未打开任何余额。请在下次解锁后检查账户与分类。"}}}},
    "capture.pending_count" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pending captures: %d"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%d 笔待检查记录"}}}},
    "capture.review_now" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unlock and review now"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"立即解锁并检查"}}}},
