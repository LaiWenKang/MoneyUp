    "onboarding.account_name_error" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter a name you will recognise, such as Daily bank."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入容易识别的名称，例如“日常银行账户”。"}}}},
    "onboarding.account_name_example" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Example: Daily bank"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"例如：日常银行账户"}}}},
    "onboarding.account_step_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This means a financial account you use, not a MoneyUp login. You can add more later."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这里指你使用的财务账户，并非 MoneyUp 登录账户。之后可继续添加。"}}}},
    "onboarding.account_step_title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add your first financial account"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加第一个财务账户"}}}},
    "onboarding.after_setup_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MoneyUp will open Today. Use Log money for your first transaction, or Plan a budget to set a monthly limit."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MoneyUp 将打开“今天”。选择“记一笔”记录第一笔交易，或选择“规划预算”设置每月限额。"}}}},
    "onboarding.after_setup_title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"You will know what to do next"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下一步清晰可见"}}}},
    "onboarding.amount_owed_error" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Amount owed must be zero or a positive number, for example 450."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所欠金额须为零或正数，例如 450。"}}}},
    "onboarding.begin_setup" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Set up my private book"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设置我的私密账本"}}}},
    "onboarding.currency_no_conversion" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Other currencies stay separate. MoneyUp never invents an exchange rate."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"其他币种会分开显示；MoneyUp 绝不会虚构汇率。"}}}},
    "onboarding.currency_step_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose the currency used for your main totals and budgets. You can still add accounts in other currencies."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择主要汇总与预算所使用的币种。之后仍可添加其他币种的账户。"}}}},
    "onboarding.currency_step_title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose your base currency"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择本位币"}}}},
    "onboarding.current_balance_error" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter a valid balance, for example 1200 or -50 for an overdraft."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入有效余额，例如 1200；透支可输入 -50。"}}}},
    "onboarding.encrypted_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your book is encrypted with a device-bound key. Removing the device passcode or deleting MoneyUp can make the live local book unrecoverable."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的账本使用设备绑定密钥加密。移除设备密码或删除 MoneyUp 可能导致本机实时账本无法恢复。"}}}},
    "onboarding.encrypted_title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Encrypted on this device"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在本机加密"}}}},
    "onboarding.no_signup_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"There is no MoneyUp username, password, tracking, or cloud analytics."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无需 MoneyUp 用户名或密码，也没有追踪与云端分析。"}}}},
    "onboarding.no_signup_title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No sign-up required"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无需注册"}}}},
