    "plan.purpose_review_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Tap each limited category and classify it. Until then, MoneyUp will not present the total as discretionary money."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请点按每个设有限额的分类并选择用途。在完成前，MoneyUp 不会把总额显示为可自由支配资金。"}}}},
