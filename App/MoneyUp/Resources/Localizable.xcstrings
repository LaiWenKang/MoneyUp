    "account.current_balance_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter what is in this account now. A negative value is allowed for an overdraft."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"填写此账户目前的余额。透支账户可输入负数。"}}}},
    "account.current_balance_error" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter a valid current balance, for example 1200 or -50."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入有效的当前余额，例如 1200 或 -50。"}}}},
