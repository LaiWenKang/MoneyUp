    "import.local_only_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Export CSV from Qianji (Settings · About → Data Export) or another budget app. Parsing and matching stay on this iPhone."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可从钱迹（设置·关于 → 数据导出）或其他记账应用导出 CSV。解析与匹配仅在此 iPhone 上完成。"}}}},
    "import.needs_review" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Rows needing review"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"需检查记录"}}}},
