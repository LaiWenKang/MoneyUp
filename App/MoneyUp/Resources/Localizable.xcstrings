    "recovery.area.other" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Other private records: %d"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"其他私密数据：%d 条记录"}}}},
    "recovery.area.receipts" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Receipt-image records: %d"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"收据图片：%d 条记录"}}}},
    "recovery.area.schedules" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Schedule records: %d"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"计划项目：%d 条记录"}}}},
    "recovery.integrity" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Data integrity"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"数据完整性"}}}},
    "recovery.key_cliff.archive_preserved" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MoneyUp copies and validates the selected archive in isolation. The file you selected is never modified."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MoneyUp 会复制所选备份并在隔离环境中验证；你选择的文件不会被修改。"}}}},
    "recovery.key_cliff.confirm_action" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recover from this backup"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"从此备份恢复"}}}},
    "recovery.key_cliff.confirm_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MoneyUp fully validates an isolated copy before replacing unreadable local ciphertext. A failed install restores the same ciphertext and missing-key recovery state. The selected file is unchanged."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MoneyUp 会先完整验证隔离副本，再替换无法读取的本机密文。安装失败时会恢复相同密文和密钥丢失恢复状态；所选文件不会改变。"}}}},
    "recovery.key_cliff.confirm_title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recover this book from backup?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"从备份恢复此账本？"}}}},
    "recovery.key_cliff.detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The live local book is still encrypted, but its device-bound key is gone. A new key cannot decrypt that ciphertext."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本机实时账本仍处于加密状态，但设备绑定密钥已丢失；新密钥无法解密这些数据。"}}}},
    "recovery.key_cliff.discard_pending" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Discard pending Quick Logs"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"丢弃待处理快捷记账"}}}},
    "recovery.key_cliff.discard_pending_confirm" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Discard pending Quick Logs"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"丢弃待处理快捷记账"}}}},
    "recovery.key_cliff.discard_pending_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pending Quick Logs belong to the inaccessible old book and cannot cross into a restored backup. Discarding them is permanent and does not change the old encrypted book."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"待处理快捷记账属于无法访问的旧账本，不能带入恢复的备份。丢弃后无法撤销，但不会改变旧加密账本。"}}}},
    "recovery.key_cliff.discard_pending_title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Discard pending Quick Logs?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"丢弃待处理快捷记账？"}}}},
    "recovery.key_cliff.pending_discarded" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pending Quick Logs discarded. You can now restore the backup."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"待处理快捷记账已丢弃。现在可以恢复备份。"}}}},
    "recovery.key_cliff.restore_action" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Restore encrypted backup"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"恢复加密备份"}}}},
    "recovery.key_cliff.restore_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose a password-protected .moneyup backup. Wrong passwords, modified files, and cancellation leave the unreadable local ciphertext and Keychain unchanged."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请选择受密码保护的 .moneyup 备份。密码错误、文件被修改或取消操作时，无法读取的本机密文和钥匙串均不会改变。"}}}},
    "recovery.key_cliff.retry" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recheck secure recovery"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重新检查安全恢复"}}}},
    "recovery.key_cliff.steps" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"First make sure this device has a passcode, then restore a verified .moneyup backup with its password. If no backup exists, the old local book cannot be recovered; erase only after accepting that loss."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先确保此设备已设置密码，再使用备份密码恢复已验证的 .moneyup 备份。若没有备份，旧本地账本将无法恢复；仅在接受数据丢失后再选择抹除。"}}}},
    "recovery.key_cliff.title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Device-key recovery"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设备密钥恢复"}}}},
    "recovery.quarantined_count" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Records needing attention: %d"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%d 条记录需要处理"}}}},
    "recovery.quarantined_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"These records remain encrypted in the database and backups but are excluded from totals until repaired."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这些记录仍保留在加密数据库和备份中，但修复前不会计入统计。"}}}},
    "restore.choose" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose .moneyup backup"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择 .moneyup 备份"}}}},
    "restore.complete" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Backup restored successfully."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"备份已成功恢复。"}}}},
