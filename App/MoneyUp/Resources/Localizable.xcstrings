    "assets.account_net_worth_note" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cash and account balances minus liabilities. Manual holding valuations are shown separately to avoid double counting."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"现金与账户余额减去负债。手动持仓估值单独显示，避免重复计算。"}}}},
