    "onboarding.privacy_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MoneyUp cannot recover this beta after deletion or device loss. Export CSV snapshots and keep them somewhere you trust."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此测试版在应用被删除或设备丢失后无法恢复。请导出 CSV 快照并妥善保存在可信位置。"}}}},
