    "receipt.error.too_large" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This image is too large to keep safely. Choose an image under 15 MB."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此图片过大，无法安全保存。请选择小于 15 MB 的图片。"}}}},
    "split.error.balance" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Split amounts must equal the transaction total exactly."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"拆分金额必须与交易总额完全一致。"}}}},
    "split.error.currency" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Every split must use the transaction currency."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每个拆分必须使用交易币种。"}}}},
    "split.error.positive" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Every split amount must be greater than zero."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每个拆分金额必须大于零。"}}}},
    "split.error.too_few" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add at least two split lines."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请至少添加两条拆分。"}}}},
    "error.calculation_unavailable" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This value is temporarily unavailable."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此数值暂时无法计算。"}}}},
