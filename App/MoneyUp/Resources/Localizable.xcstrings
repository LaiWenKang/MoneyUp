    "error.account_currency" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This account has no currency."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此账户没有币种。"}}}},
    "error.accounts_must_differ" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose two different accounts."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请选择两个不同的账户。"}}}},
    "error.amount_must_be_nonzero" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Amount must not be zero."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"金额不能为零。"}}}},
    "error.amount_must_be_positive" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Amount must be greater than zero."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"金额必须大于零。"}}}},
    "error.amount_too_large" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"That amount is too large to save safely. Enter a smaller amount."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"该金额过大，无法安全保存。请输入较小的金额。"}}}},
    "error.app_locked" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MoneyUp is locked."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MoneyUp 已锁定。"}}}},
    "error.authentication_cancelled" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Authentication was cancelled."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已取消身份验证。"}}}},
    "error.balance_currency_mismatch" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The amounts use different currencies and cannot be balanced."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"金额使用了不同币种，无法保持平衡。"}}}},
    "error.balance_invalid" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The transaction could not be balanced. Check the amounts and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"交易无法保持平衡。请检查金额后重试。"}}}},
    "error.budget_invalid" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The budget setup is invalid. No changes were saved."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"预算设置无效，未保存任何更改。"}}}},
    "error.could_not_open" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MoneyUp could not open your private data"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MoneyUp 无法打开你的私密数据"}}}},
    "error.device_passcode_required" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Set a device passcode before using MoneyUp."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用 MoneyUp 前请先设置设备密码。"}}}},
    "error.empty_name" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter a name."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入名称。"}}}},
    "error.fx_transfer_not_supported" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter the amount received for this currency exchange."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入本次货币兑换的到账金额。"}}}},
    "error.invalid_amount" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter a valid amount."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入有效金额。"}}}},
    "error.invalid_book" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The private book failed an integrity check. No records were changed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"私密账本未通过完整性检查，任何记录均未更改。"}}}},
    "error.invalid_category" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This category type is not supported."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"不支持此分类类型。"}}}},
    "error.invalid_database_key" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The protected database key is invalid."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"受保护的数据库密钥无效。"}}}},
    "error.missing_device_bound_key" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The device-bound key for this local book is missing. The existing encrypted data cannot be opened with a replacement key."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此本地账本的设备绑定密钥已丢失。现有加密数据无法使用替代密钥打开。"}}}},
    "error.keychain_unavailable" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The device Keychain is unavailable."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设备钥匙串不可用。"}}}},
    "error.missing_record" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The selected record no longer exists."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所选记录已不存在。"}}}},
    "error.negative_amount" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Amount cannot be negative."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"金额不能为负数。"}}}},
    "error.persistence_data_invalid" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MoneyUp found invalid private data. No records were changed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MoneyUp 发现无效的私密数据，未更改任何记录。"}}}},
    "error.persistence_unavailable" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MoneyUp could not securely access your private data. Try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MoneyUp 无法安全访问你的私密数据。请重试。"}}}},
    "error.persistence_update_required" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This private data was created by a newer MoneyUp version. Update MoneyUp to open it."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这份私密数据由较新版本的 MoneyUp 创建。请更新 MoneyUp 后再打开。"}}}},
    "error.export_failed_safe" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MoneyUp could not prepare the export. Try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MoneyUp 无法准备导出文件。请重试。"}}}},
    "error.generic_safe" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MoneyUp could not complete that action. Try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MoneyUp 无法完成该操作。请重试。"}}}},
    "error.import_failed_safe" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MoneyUp could not import that file. Check the file and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MoneyUp 无法导入该文件。请检查文件后重试。"}}}},
    "error.read_failed_safe" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MoneyUp could not read that file. Choose it again or try another file."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MoneyUp 无法读取该文件。请重新选择或尝试其他文件。"}}}},
    "error.restore_failed_safe" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MoneyUp could not restore that backup. Your current book was kept unchanged."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MoneyUp 无法恢复该备份。当前账本保持不变。"}}}},
    "error.restore_recovery_failed" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MoneyUp could not safely recover after the restore stopped. Lock and reopen the app before making changes."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"恢复中断后，MoneyUp 无法安全恢复当前账本。请先锁定并重新打开应用，再进行更改。"}}}},
    "error.save_failed_safe" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MoneyUp could not save that change. Check the details and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MoneyUp 无法保存该更改。请检查内容后重试。"}}}},
    "error.scan_failed_safe" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MoneyUp could not read that image. Retake or crop it and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MoneyUp 无法读取该图片。请重新拍摄或裁剪后重试。"}}}},
    "error.unlock_failed_safe" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MoneyUp could not securely open your private data. Try unlocking again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MoneyUp 无法安全打开你的私密数据。请重新解锁。"}}}},
    "error.write_failed_safe" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MoneyUp could not save that file. Choose a location and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MoneyUp 无法保存该文件。请选择位置后重试。"}}}},
    "export.continue" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Export CSV"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导出 CSV"}}}},
    "export.csv" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Export for Numbers or Excel"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导出至 Numbers 或 Excel"}}}},
    "export.warning_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"CSV and XLSX exports are readable and not encrypted. Receipt image bytes are excluded. Save or share exports only to a location you trust."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"CSV 与 XLSX 导出文件可直接读取且未加密，并且不会包含收据图片。请仅保存或分享至你信任的位置。"}}}},
    "export.warning_title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Export readable financial data?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导出可读的财务数据？"}}}},
