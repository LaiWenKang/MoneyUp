    "plan.rollover.full_balance" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Full signed balance"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"结转完整正负余额"}}}},
    "plan.rollover.none" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No carry-forward"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"不结转"}}}},
    "plan.rollover.positive_only" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unused amount only"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅结转未用金额"}}}},
    "plan.rollover_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No carry-forward resets to the configured limit. Unused amount only carries a positive remainder. Full signed balance also carries overspending into the next Gregorian month. Enabling starts this month; earlier history is not backfilled."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"“不结转”每月恢复设定上限；“仅结转未用金额”只带入正数余款；“结转完整正负余额”也会把超支带到下个公历月。启用后从本月开始，不回溯旧月份。"}}}},
    "settings.reporting_time_zone" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reporting time zone"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"报表时区"}}}},
    "settings.widget.budget_status" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow budget percentage widget"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"允许预算百分比小组件"}}}},
    "settings.widget.budget_status_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Off by default. When enabled, MoneyUp shares only a rounded percent used with the widget—never an amount, payee, account, holding, or balance. Choose Budget status while editing the widget."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"默认关闭。启用后，MoneyUp 只会向小组件共享取整后的已用百分比，绝不共享金额、商户、账户、持仓或余额。编辑小组件时请选择“预算状态”。"}}}},
    "settings.widget.budget_status_hint" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Controls whether the widget may read a percentage-only budget snapshot."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"控制小组件是否可以读取仅含百分比的预算快照。"}}}},
    "settings.widgets_and_reports" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Widgets and reporting"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"小组件与报表"}}}}
