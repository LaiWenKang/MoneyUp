    "dashboard.privacy_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your financial data stays on this device unless you choose to export it."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"除非你主动导出，否则财务数据只保留在此设备上。"}}}},
