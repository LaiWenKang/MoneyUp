    "whats_new.0_4_1.history" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A new History tab adds fast search, filters, refunds, and safe transaction editing."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"全新明细标签页支持快速搜索、筛选、退款与安全编辑交易。"}}}},
    "whats_new.0_4_1.import" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Preview and import Qianji or generic CSV exports locally, with duplicate detection and atomic saving."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可在本机预览并导入钱迹或通用 CSV，自动查重并以事务方式保存。"}}}},
    "whats_new.0_4_1.safety" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Password-protected portable backup and transactional restore help your TestFlight data move safely to future releases."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"密码保护的便携备份与事务恢复，让 TestFlight 数据可安全迁移到后续正式版本。"}}}},
    "whats_new.0_4_1.speed" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Log remains leftmost, tab navigation is no longer blocked, smart defaults are configurable, and auto-lock defaults to one minute."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"记账仍在最左侧，标签切换不再受阻，可配置智能默认值，自动锁定默认为 1 分钟。"}}}},
    "capture.detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Capture this entry without opening your balances. It moves into the encrypted ledger after your next unlock."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无需打开余额即可先记录。下次解锁后，它会移入加密账本。"}}}},
    "capture.error.full" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The secure capture inbox is full. Unlock MoneyUp to process pending entries."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"安全速记收件箱已满。请解锁 MoneyUp 处理待办记录。"}}}},
    "capture.error.invalid" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The secure capture inbox could not be read. Your main ledger is unaffected."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法读取安全速记收件箱。主账本不受影响。"}}}},
    "capture.error.unavailable" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Quick Capture is unavailable until the iPhone has been unlocked once after restarting."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"iPhone 重启后需先解锁一次，才能使用快速记录。"}}}},
    "capture.private" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Balances stay locked"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"余额仍保持锁定"}}}},
    "capture.reconcile_later" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Account and category are applied from your defaults when the book is unlocked."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"账本解锁后，会按你的默认设置补充账户和分类。"}}}},
    "capture.title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Quick Capture"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"快速记录"}}}},
