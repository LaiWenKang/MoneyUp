    "holding.connect_ledger" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connect holding to ledger"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将持仓连接到账本"}}}},
    "holding.migration_review_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No migration is committed until you choose the interpretation that matches your existing balance."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"只有在你选择符合现有余额的解释后，迁移才会提交。"}}}},
    "holding.cash_includes_position" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cash still includes this investment"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"现金余额仍包含此投资"}}}},
    "holding.cash_excludes_position" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cash already excludes this investment"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"现金余额已排除此投资"}}}},
    "holding.migration_choice_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose whether MoneyUp should move value from recorded cash or add the missing position value through opening equity."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请选择 MoneyUp 应从已记录现金转移价值，还是通过期初权益补上缺少的持仓价值。"}}}},
    "holding.cash_account" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Matching investment cash account"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"匹配的投资现金账户"}}}},
    "holding.add_matching_account" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add an active investment or brokerage cash account in this holding's currency first."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先添加一个使用此持仓币种的投资或券商现金账户。"}}}},
    "holding.error.currency_mismatch" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The holding price currency must match its cash account."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"持仓价格币种必须与现金账户币种一致。"}}}},
    "holding.error.needs_ledger" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review and connect this legacy holding to the ledger first."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先确认并将此旧版持仓连接到账本。"}}}},
    "holding.error.missing_price" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A positive holding quantity requires a unit price."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"持仓数量大于零时必须填写单价。"}}}},
    "holding.error.not_empty" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sell the remaining quantity before deleting this holding so its ledger value stays explainable."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先卖出剩余持仓，再删除此项目，以确保账本价值仍可解释。"}}}},
    "holding.error.invalid_trade" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter a positive quantity and unit price for this investment action."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请为此投资操作输入大于零的数量与单价。"}}}},
    "holding.error.insufficient_quantity" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The sale quantity exceeds the open FIFO lots."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"卖出数量超过未结的先进先出批次数量。"}}}},
    "holding.error.date_out_of_order" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose a date on or after this holding's latest retained activity. Earlier changes require chronological replay and are not applied silently."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请选择不早于此持仓最新活动的日期。更早的变更需要按时间顺序重放，MoneyUp 不会静默套用。"}}}},
    "holding.error.date_in_future" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Investment activity cannot be dated in the future because it would change today's net worth."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"投资活动不能设为未来日期，因为这会改变今天的净资产。"}}}},
    "holding.error.linked_entry_protected" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"System balance adjustments and investment entries cannot be edited or deleted here. Add a dedicated correction instead."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"系统余额调整和投资分录不能在此编辑或删除；请改用专用更正流程。"}}}},
    "holding.error.snapshot_needs_ledger" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connect every non-zero legacy holding to the ledger before saving a net-worth snapshot."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保存净资产快照前，请先将所有非零旧版持仓连接到账本。"}}}},
    "holding.opening_position_note" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Existing investment position opening value"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已有投资持仓的期初价值"}}}},
    "holding.opening_treatment" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"How is this position reflected in cash?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此持仓目前如何体现在现金中？"}}}},
    "holding.opening_deduct_title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Record a purchase now"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"现在记录一笔买入"}}}},
    "holding.opening_deduct_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Deduct quantity × price from the selected investment cash account and move it into the position."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"从所选投资现金账户扣除数量 × 单价，并转入此持仓。"}}}},
    "holding.opening_existing_title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cash already excludes this position"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"现金余额已排除此持仓"}}}},
    "holding.opening_existing_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keep cash unchanged and add the already-owned position through opening equity."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保持现金不变，并通过期初权益加入已持有的仓位。"}}}},
    "holding.opening_treatment_help" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MoneyUp will not guess. Choose the statement that matches the balance you entered for this brokerage account."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MoneyUp 不会猜测。请选择与你为此券商账户填写的余额一致的说明。"}}}},
    "whats_new.0_7_0.intelligence" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Optional local intelligence can flag recurring or lapsed patterns, price changes, exact duplicates, and unusual spending with inspectable rules and evidence."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可选的本机智能现在可提示周期或中断规律、价格变化、完全重复及异常支出，并展示可核查的规则与依据。"}}}},
    "whats_new.0_7_0.projections" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Currency-separated month-end projections and reviewable budget proposals explain every component; schedules and limits change only after you confirm them."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"按币种分列的月末预测与可审阅的预算建议会解释每个组成部分；计划项目与限额仅会在你确认后变更。"}}}},
    "whats_new.0_7_0.language" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose System, English, or Simplified Chinese in Settings; the selected language applies consistently to MoneyUp and its widget."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可在设置中选择“跟随系统”、英语或简体中文；所选语言会一致应用于 MoneyUp 与小组件。"}}}},
    "whats_new.0_7_0.details" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Log now keeps title or merchant and multi-line description or notes visible, and lets you create and fully manage your own categories."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"记账页现会持续显示标题或商户及多行描述或备注，并支持新建及完整管理自定义分类。"}}}},
    "whats_new.0_7_0.privacy" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"All intelligence remains on device, optional, and review-only. Disabling it clears derived findings without deleting or rewriting financial records."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所有智能功能仍仅在本机运行、可选择关闭且只供审阅；关闭后仅清除派生结果，不会删除或改写财务记录。"}}}},
    "whats_new.0_6_0.history" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"History and Calendar now use encrypted date indexes and bounded loading, while exact edits, splits, schedules, and lifecycle changes update the ledger atomically."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"交易记录与日历现使用加密日期索引和有界加载；精确编辑、拆分、计划项目与项目生命周期变更都会以原子方式更新账本。"}}}},
    "whats_new.0_6_0.investments" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Ledger-linked holdings now include dated pricing, stale-price warnings, FIFO lots and sales, currency-separated positions, and historical net-worth snapshots."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"与账本关联的持仓现支持按日期定价、过期价格提示、先进先出批次与卖出、按币种分列的头寸及历史净值快照。"}}}},
    "whats_new.0_6_0.plan" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Plan now supports budget rollover, sinking funds, savings goals, dated contributions and withdrawals, and explicit reset behavior."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"规划现支持预算结转、沉淀资金、储蓄目标、带日期的存入与取出，以及明确的重置规则。"}}}},
    "whats_new.0_6_0.portability" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A privacy-safe data inventory, native XLSX, mapped CSV/TSV import, dated exchange rates, and optional encrypted receipt attachments make updates, migration, and recovery easier to verify without exposing or inventing values."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保护隐私的数据清单、原生 XLSX、可映射的 CSV／TSV 导入、按日期汇率及可选加密收据附件，让更新、迁移与恢复更易核对，同时绝不暴露或虚构数值。"}}}},
    "whats_new.0_6_0.widget" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"An optional budget-status widget can show only a percentage and state; it never receives amounts, payees, account names, holdings, balances, or ledger identifiers."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可选的预算状态小组件仅显示百分比与状态；它绝不会接收金额、商户、账户名称、持仓、余额或账本标识符。"}}}},
    "whats_new.0_5_2.keyboard" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The amount keypad now has an obvious Done action, Save stays reachable above it, and switching tabs cleanly dismisses the keyboard."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"金额键盘现提供清晰的“完成”操作，“保存”会保持在键盘上方，切换标签页时也会顺畅收起键盘。"}}}},
    "whats_new.0_5_2.receipt" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Receipt and screenshot reading now shows progress immediately and fills visible amount, payee, and date suggestions sooner."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"读取收据或截图时现在会立即显示进度，并更快填入可见的金额、商家与日期建议。"}}}},
    "whats_new.0_5_2.verification" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The release workflow now runs app-model tests on the exact candidate commit before packaging and upload."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"发布流程现在会先在准确的候选提交上运行应用模型测试，再进行打包与上传。"}}}},
    "lifecycle.add_expense_category" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add expense category"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加支出分类"}}}},
    "lifecycle.add_income_category" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add income category"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加收入分类"}}}},
    "lifecycle.archive" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Archive"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"归档"}}}},
    "lifecycle.archived" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Archived"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已归档"}}}},
    "lifecycle.confirm_archive" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This item will disappear from new-entry and default pickers. Existing transactions, reports, schedules, and balances remain."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此项目将不再出现在新建交易与默认选项中。现有交易、报表、计划项目和余额会保留。"}}}},
    "lifecycle.confirm_delete" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This item has no references and can be permanently deleted. This cannot be undone."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此项目没有任何引用，可以永久删除。此操作无法撤销。"}}}},
    "lifecycle.confirm_merge" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Every reference will move to the selected destination in one encrypted transaction. Category budget limits are combined; the destination purpose is kept."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所有引用会在一次加密事务中移至所选目标。分类预算上限会合并，并保留目标分类的用途。"}}}},
    "lifecycle.confirm_reassign" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Every reference will move to the selected destination before this item is deleted. The operation either completes fully or changes nothing."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除此项目之前，所有引用会先移至所选目标。操作要么全部完成，要么完全不作更改。"}}}},
    "lifecycle.confirm_restore" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This item will be available again in new-entry and default pickers."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此项目会重新出现在新建交易与默认选项中。"}}}},
    "lifecycle.confirm_title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirm lifecycle change"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认项目变更"}}}},
    "lifecycle.delete_reassign" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete and reassign"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除并重新分配"}}}},
    "lifecycle.delete_unused" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete unused item"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除未使用项目"}}}},
    "lifecycle.destination" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Destination"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"目标项目"}}}},
    "lifecycle.error.in_use" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This item is still used. Choose a compatible destination and merge or delete with reassignment."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此项目仍在使用中。请选择兼容的目标并合并，或在重新分配后删除。"}}}},
    "lifecycle.error.archived" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This item is archived. Restore it before using it in a new transaction."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此项目已归档。请先恢复，再用于新交易。"}}}},
    "lifecycle.error.incompatible" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"These items cannot be combined. Their account kind and currency must match, and the destination must be active."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这些项目无法合并。账户种类与币种必须一致，且目标项目必须处于启用状态。"}}}},
    "lifecycle.error.system_account" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MoneyUp system accounts are protected because ledger balancing depends on them."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MoneyUp 系统账户受保护，因为账本平衡依赖这些账户。"}}}},
    "lifecycle.impact_summary" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Impact — transactions: %1$d; schedules: %2$d; holdings: %3$d; child items: %4$d; defaults: %5$d; draft fields: %6$d; configured budgets: %7$d."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将影响 %1$d 笔交易、%2$d 个计划项目、%3$d 个持仓、%4$d 个子项目、%5$d 个默认项、%6$d 个草稿字段及 %7$d 个已设置预算。"}}}},
    "lifecycle.manage" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Manage lifecycle"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"管理项目"}}}},
    "lifecycle.manage_categories" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Manage categories"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"管理分类"}}}},
    "lifecycle.merge" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Merge into destination"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"合并至目标项目"}}}},
    "lifecycle.name" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Name"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"名称"}}}},
    "lifecycle.restore" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Restore"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"恢复使用"}}}},
    "whats_new.0_5_1.flexible" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Flexible Today now uses only allocations you explicitly classify as flexible; bills, debt, and goals remain protected."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"“今日灵活可用”现在只计入你明确分类为灵活支出的金额；账单、债务与目标资金会保持受保护。"}}}},
    "whats_new.0_5_1.capture" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Basic widget actions open amount-first private capture without unlocking MoneyUp, then show a clear saved confirmation."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"基础小组件操作无需解锁 MoneyUp，即可直接输入金额并私密记录，保存后会显示清晰确认。"}}}},
    "whats_new.0_5_1.focus" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Log keeps optional details out of the routine path, focuses the amount, and keeps the primary Save action above the keyboard."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"记账会优先聚焦金额，将可选详情收起，并把主要保存操作保持在键盘上方。"}}}},
    "whats_new.0_5_1.visuals" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Illustrations now use compact, responsive roles so decisions and actions receive the screen space first."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"插图现在采用紧凑且响应式的尺寸，让决策信息与主要操作优先获得屏幕空间。"}}}},
    "whats_new.0_5_0.guidance" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Safe to Spend Today now shows the exact daily amount, its arithmetic, scheduled commitments, and every important exclusion."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"“今天可安心支出”现会显示准确的每日金额、计算过程、计划支出及所有重要排除项。"}}}},
    "whats_new.0_5_0.insights" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Tap category and monthly-flow charts to inspect a value and open the matching filtered transaction history."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"点按分类与月度现金流图表即可查看数值，并打开相应筛选后的交易记录。"}}}},
    "whats_new.0_5_0.simulator" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A private budget what-if simulator previews extra spending or income without changing the ledger, budget, or reports."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"新增私密预算情景模拟，可预览额外支出或收入，且不会改变账本、预算或报表。"}}}},
    "whats_new.0_5_0.visuals" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"New dimensional illustrations, exact 2D diagrams, richer icons, guided empty states, and horned-money widget graphics bring the visual system together."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"新增立体插图、准确的二维图示、更丰富的图标、引导式空状态与牛角钱币小组件图形，统一整体视觉系统。"}}}},
    "action.done" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Done"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"完成"}}}},
    "assets.no_holdings_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add a manual holding after creating an investment or brokerage account."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"创建投资或券商账户后，可添加手动持仓。"}}}},
    "dashboard.budget_pace.ahead" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spending is ahead of calendar pace"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"支出进度快于本月时间进度"}}}},
    "dashboard.budget_pace.over" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Budget limit exceeded"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已超出预算上限"}}}},
    "dashboard.budget_pace.within" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spending is within calendar pace"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"支出仍在本月时间进度内"}}}},
    "dashboard.card_loan_debt" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Card and loan debt"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"信用卡与贷款欠款"}}}},
    "dashboard.cash_on_hand" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cash on hand"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"手头现金"}}}},
    "dashboard.net_cash" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Net cash"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"净现金"}}}},
    "dashboard.position_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Base-currency cash and debt stay separate. MoneyUp never converts other currencies automatically."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本位币现金与负债分开显示。MoneyUp 绝不会自动换算其他币种。"}}}},
    "dashboard.position_title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cash and debt"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"现金与负债"}}}},
    "dashboard.safe_to_spend" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Flexible Today"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"今日灵活可用"}}}},
    "dashboard.safe_to_spend.attention" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your flexible plan is over target"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的灵活支出计划已超出目标"}}}},
    "dashboard.safe_to_spend.budget_remaining" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Flexible budget remaining"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"灵活支出剩余预算"}}}},
    "dashboard.safe_to_spend.commitments" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Upcoming flexible commitments"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"即将发生的灵活支出"}}}},
    "dashboard.safe_to_spend.days_remaining" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Days remaining, including today"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"剩余天数（含今天）"}}}},
    "dashboard.safe_to_spend.exclusion_income" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Future income is not counted until it is recorded."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未来收入在实际记录前不会计入。"}}}},
    "dashboard.safe_to_spend.exclusion_unbudgeted" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Spending in categories outside the budget is excluded."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"预算外分类的支出不计入此数值。"}}}},
    "dashboard.safe_to_spend.exclusions" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"What this does not include"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此计算未包含的内容"}}}},
    "dashboard.safe_to_spend.foreign_excluded" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Different-currency commitment"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"其他币种的计划支出"}}}},
    "dashboard.safe_to_spend.foreign_spending_excluded" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Different-currency spending this month"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本月其他币种支出"}}}},
    "dashboard.safe_to_spend.how" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"How this is calculated"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"计算方式"}}}},
    "dashboard.safe_to_spend.needs_budget" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Create a flexible spending budget"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"创建灵活支出预算"}}}},
    "dashboard.safe_to_spend.needs_budget_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MoneyUp only divides money you explicitly mark as flexible. Bills, debt, and goals stay protected."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MoneyUp 只会分配你明确标记为灵活支出的金额；账单、债务与目标资金会保持受保护。"}}}},
    "dashboard.safe_to_spend.no_rates" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MoneyUp stores no exchange rates, so different-currency activity stays separate."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MoneyUp 不存储汇率，因此其他币种的活动会分开显示。"}}}},
    "dashboard.safe_to_spend.per_day" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"per day through month end"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"从今天到月末的每日金额"}}}},
    "dashboard.safe_to_spend.period" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Applicable period"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"适用期间"}}}},
    "dashboard.safe_to_spend.period_available" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Flexible amount for the rest of the month"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本月余下的灵活支出金额"}}}},
    "dashboard.safe_to_spend.review_schedules" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%d active schedules use an earlier recurrence anchor; review them in Calendar."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%d 个启用中的计划项目使用较早的重复起点；请在日历中检查。"}}}},
    "dashboard.safe_to_spend.schedule_assumption" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Only projected expenses governed by a flexible allocation are deducted, and each is deducted once."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"只扣除归属于灵活预算的计划支出，且每笔只扣除一次。"}}}},
    "dashboard.flexible_today.classify_title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Planned allocations to classify: %d"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请为 %d 个计划金额选择用途"}}}},
    "dashboard.flexible_today.classify_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose Flexible, Bills, Debt, or Goals before MoneyUp shows a daily amount."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先选择灵活支出、账单、债务或目标，MoneyUp 才会显示每日金额。"}}}},
    "dashboard.flexible_today.needs_flexible" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No flexible allocation yet"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"尚未设置灵活支出金额"}}}},
    "dashboard.flexible_today.needs_flexible_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your bills, debt, and goals remain protected. Mark an allocation as Flexible to calculate a daily pace."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"账单、债务与目标资金仍受保护。将一个计划金额标记为灵活支出后即可计算每日进度。"}}}},
