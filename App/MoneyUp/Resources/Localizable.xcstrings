    "import.review_mappings_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Every source name shown here will post to the MoneyUp item you approve."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这里显示的每个来源名称都会记入你确认的 MoneyUp 项目。"}}}},
    "quick_log.keep_receipt" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keep this receipt with the transaction"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将此收据保留在交易中"}}}},
    "quick_log.keep_receipt_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Off by default. If enabled, MoneyUp removes location and camera metadata, then saves a bounded copy only after you save, inside the encrypted database and encrypted backups."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"默认关闭。启用后，MoneyUp 会移除位置与相机元数据，并仅在你保存交易后，将受限大小的副本写入加密数据库与加密备份。"}}}},
    "quick_log.keep_receipt_hint" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The original photo is used transiently for on-device recognition; it is never stored in an unfinished draft or widget."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"原始照片仅临时用于设备端识别，不会写入未完成草稿或小组件。"}}}},
    "quick_log.split_add" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add split"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加拆分"}}}},
    "quick_log.split_amount" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Split amount"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"拆分金额"}}}},
    "quick_log.split_amount_numbered" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Split %d amount"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"第 %d 条拆分金额"}}}},
    "quick_log.split_balanced" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The split balances exactly and can be saved."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"拆分已精确平衡，可以保存。"}}}},
    "quick_log.split_category" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Split category"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"拆分分类"}}}},
    "quick_log.split_category_numbered" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Split %d category"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"第 %d 条拆分分类"}}}},
    "quick_log.split_memo" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Split note (optional)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"拆分备注（可选）"}}}},
    "quick_log.split_memo_numbered" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Split %d note (optional)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"第 %d 条拆分备注（可选）"}}}},
    "quick_log.split_not_balanced" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allocate the exact remaining amount before saving."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保存前请精确分配剩余金额。"}}}},
    "quick_log.split_remainder" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remaining"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"剩余"}}}},
