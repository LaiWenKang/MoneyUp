    "onboarding.welcome_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"In four short steps, you will create a private local money book and know exactly where to begin."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"只需四个简短步骤，即可创建私密的本地账本，并清楚知道从哪里开始。"}}}},
