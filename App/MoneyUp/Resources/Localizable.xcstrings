    "settings.security.key_cliff_warning" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Removing the device passcode or deleting MoneyUp can make the live local book unrecoverable. Keep a password-protected .moneyup backup outside the app."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"移除设备密码或删除 MoneyUp 可能导致本机实时账本无法恢复。请在应用之外保留受密码保护的 .moneyup 备份。"}}}},
    "settings.smart_default" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Smart / recent"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"智能／最近使用"}}}},
    "settings.smart_default_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Smart mode prefers your most-used valid choice from recent transactions."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"智能模式会优先选择近期交易中最常用且仍有效的选项。"}}}},
