    "receipt.delete_attachment" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete receipt image"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除收据图片"}}}},
    "receipt.delete_attachment_hint" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Asks for confirmation before permanently deleting this encrypted image."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"永久删除此加密图片前会要求确认。"}}}},
    "receipt.delete_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This encrypted receipt image will be permanently deleted. This cannot be undone."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此加密收据图片将被永久删除，且无法撤销。"}}}},
    "receipt.delete_title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete encrypted receipt image?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除加密收据图片？"}}}},
