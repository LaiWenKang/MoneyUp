    "recovery.area.accounts" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Account records: %d"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"账户：%d 条记录"}}}},
    "recovery.area.budgets" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Budget records: %d"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"预算：%d 条记录"}}}},
