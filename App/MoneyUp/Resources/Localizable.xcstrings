    "whats_new.0_4_0.log" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Log is now the leftmost tab, keeps useful defaults, restores unfinished entries from encrypted storage, and offers Undo."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"记账现已移至最左侧标签页，保留常用选项、从加密存储恢复未完成内容，并支持撤销。"}}}},
    "whats_new.0_4_0.trust" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Dashboard and reports now use clearer liquid-position, budget, recurrence, and selected-period calculations."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"首页与报表现采用更清晰的流动资金、预算、周期计划及所选统计区间计算。"}}}},
    "whats_new.0_4_0.widgets" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Widgets now let you choose Expense, Income, Transfer, Smart Entry, or Receipt, including Lock Screen sizes."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"小组件现可选择支出、收入、转账、智能记账或选择小票，并支持锁定屏幕尺寸。"}}}},
