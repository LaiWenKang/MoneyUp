    "onboarding.recovery_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Create a password-protected .moneyup backup and keep it outside the app before changing passcode protection, deleting MoneyUp, or changing devices."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在更改设备密码保护、删除 MoneyUp 或更换设备前，请创建受密码保护的 .moneyup 备份并保存在应用之外。"}}}},
