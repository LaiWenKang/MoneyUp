    "whats_new.0_4_1.guidance" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A calm soft-green light/dark design, clearer first-run guidance, and consumer-language account setup."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"采用舒适的柔和绿色明暗设计，并提供更清晰的新手引导与易懂的账户设置。"}}}},
    "account.amount_owed_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter what you currently owe. Use a positive number; MoneyUp will treat it as debt."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"填写目前所欠金额。请输入正数，MoneyUp 会将其作为负债处理。"}}}},
    "account.amount_owed_error" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter a valid amount owed using zero or a positive number."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入有效的所欠金额，数值须为零或正数。"}}}},
