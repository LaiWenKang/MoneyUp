    "account.name_error" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Give this account a name so you can recognise it later."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请为此账户命名，以便日后识别。"}}}},
