    "goal.delete_detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This permanently deletes the goal, contributions, withdrawals, and reset history. Ledger transactions are unchanged."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这会永久删除目标、存入、取出及重置记录，但不会更改账本交易。"}}}},
