    "whats_new.0_2_0.currencies" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reports keep every currency. Money spent outside your base currency is listed separately instead of being left out." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "报表保留所有币种。非本位币的收支会单独列出，不再被忽略。" } } } },
    "whats_new.0_2_0.periods" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose the report period: this month, last month, 3, 6 or 12 months, or year to date." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "可选择统计区间：本月、上月、近 3/6/12 个月或今年至今。" } } } },
    "whats_new.0_2_0.smart_entry" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Log from a receipt photo or a typed phrase. Everything is read on this device." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "可通过收据照片或一句话记账，全部在本机识别。" } } } },
